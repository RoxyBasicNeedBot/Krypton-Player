# ==============================================================================
# ARCH PLAYER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file as .env or set these in GitHub Actions Secrets.
# ==============================================================================

# --- Backend & Cloudflare Worker Gateway ---
ARCH_API_URL=https://your-worker.domain.workers.dev/
ARCH_CLIENT_KEY=your_client_key_here

# --- Telegram MTProto & Bot Credentials ---
BOT_TOKEN=your_bot_token_here
API_ID=your_telegram_api_id_here
API_HASH=your_telegram_api_hash_here
OWNER_CHAT_ID=your_chat_ids_here
TOPIC_ID=

# --- GitHub CI Actions Token (CI only, never embedded in client binaries) ---
GH_TOKEN=

# --- Media Metadata & Subtitles APIs ---
TMDB_API_KEY=
FANART_API_KEY=
OPENSUBTITLES_API_KEY=

# --- App Release Keystore Signing ---
KEYSTORE_PASSWORD=your_keystore_password_here
KEY_PASSWORD=your_key_password_here
